# Base URL of the Storporate backend API (storporate.backend, `dotnet run --project src/Storporate.Api`).
NEXT_PUBLIC_API_BASE_URL=https://localhost:7106

# --- NextAuth (STOR-61 Phase 4) ---
# Generate your own local-dev secret with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth web-application client (browser-side handshake only; the resulting ID token is
# verified independently by the backend against its own GoogleAuth__ClientId).
# DEVIATION (plan-noted constraint): no real Google Cloud OAuth app exists yet, so these are
# placeholders — Google sign-in cannot be end-to-end tested until a real client id/secret exist.
GOOGLE_CLIENT_ID=REPLACE_WITH_REAL_GOOGLE_OAUTH_CLIENT_ID_ONCE_CREATED
GOOGLE_CLIENT_SECRET=REPLACE_WITH_REAL_GOOGLE_OAUTH_CLIENT_SECRET_ONCE_CREATED
